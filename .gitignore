best/outputs/
best/runs/
best/uploads/
crime-detection/outputs/
crime-detection/runs/
bns-backend/runs/


# ==============================================================================
# AI / ML MODEL FILES
# Large binary model weights that must NOT be committed to Git.
# Each service downloads or trains its own models.
# ==============================================================================

# Generic model weight formats
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.bin
*.safetensors

# YOLOv8 object detection service (best) - model weights, unpacked torch tensors, and archive data
best/*.pt
best/data/
best/.data/
best/data.pkl
best/byteorder
best/.format_version
best/.storage_alignment
best/version

# Legacy crime detection
crime-detection/model/best.pt
crime-detection/model/yolov8n.pt

# BNS backend — trained HGAT model + FAISS retrieval files
# best_rag_hgat_model.pth  → 76 MB trained weight. Use Git LFS:
#   git lfs track "bns-backend/Model_Data/best_rag_hgat_model.pth"
# The three small files below (total < 300 KB) are required at runtime and
# should remain tracked in Git:
#   faiss.index            (124 KB)
#   section_embeddings.npy (124 KB)
#   sections_meta.json     (22 KB — has a fallback, but track anyway)
bns-backend/Model_Data/best_rag_hgat_model.pth

# HuggingFace model cache (downloaded at runtime via transformers library)
.cache/huggingface/
~/.cache/huggingface/

# PaddleOCR downloaded model cache
~/.paddlex/


# ==============================================================================
# DATASETS — ROBOFLOW EXPORTS & TRAINING DATA
# Downloaded or generated training datasets are NOT source code.
# ==============================================================================
crime-detection/dataset/
crime-detection/roboflow_dataset/
crime-detection/Weapon-Detection-SYstem-1/
crime-detection/gun-and-knife-detection-1/
crime-detection/weapons-detection-1/

# BNS training data and generated evaluation CSVs/plots
bns-backend/data/
bns-backend/Images/

# Sample / demo data: the 3 files in sample_data/ are actively used by the
# running crime-detection service as API fallbacks (objectdetection.py:462,536).
# They must remain tracked. Do NOT add crime-detection/sample_data/ here.


# ==============================================================================
# ARCHIVES & GENERATED REPORTS
# ==============================================================================
*.zip
crime-detection/crime_object_detection_yolov8.zip

# Generated PDF reports — scoped to avoid ignoring intentional PDFs
# (e.g. IEEE paper submissions, technical reports, or printed guides).
# Add specific generated output paths here rather than a global *.pdf rule.
reports/*.pdf
generated/*.pdf
# If you need to ignore a specific generated PDF, add it explicitly, e.g.:
# backend/generate_pdf_report_output.pdf

# Generated LaTeX artefacts
*.aux
*.out
*.synctex.gz


# ==============================================================================
# BLOCKCHAIN — GANACHE PERSISTENT DATABASE & HARDHAT BUILD CACHE
# ganache-data/ is a LevelDB store of a local development chain.
# artifacts/ and cache/ are Hardhat build outputs, fully re-generatable.
# deployments/ contains the live contract address and MUST be committed so
# the backend can find the deployed contract on startup.
# ==============================================================================
blockchain/ganache-data/
blockchain/artifacts/
blockchain/cache/

# Keep deployments — backend reads blockchain/deployments/localhost.json
# !blockchain/deployments/


# ==============================================================================
# ROOT-LEVEL JOBS DIRECTORY (photogrammetry job queue runtime state)
# ==============================================================================
/jobs/


# ==============================================================================
# DEPRECATED MODULE — object-backend
# This directory is a legacy remnant and should not be committed.
# ==============================================================================
object-backend/


# ==============================================================================
# INTERNAL DOCUMENTATION NOT FOR PUBLIC REPOSITORY
# ==============================================================================
docs/
COLLABORATION_GUIDE.md
CLAUDE.md
.claude/


# ==============================================================================
