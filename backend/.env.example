SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ROBOFLOW_API_KEY=your_roboflow_api_key_here
JWT_SECRET=your_jwt_secret_here
EMAIL_USER=your_email_user_here
EMAIL_PASSWORD=your_email_password_here

# Set to True to save evidence files locally in the "uploads" directory rather than Supabase Storage
USE_LOCAL_STORAGE=False

# OCR configuration. PaddleOCR downloads each model on first use and caches it
# under ~/.paddlex/official_models.
# Detection model. The CPU-friendly default is PP-OCRv5_mobile_det; on a GPU
# host PP-OCRv6_medium_det gives better recall on small or dense text.
OCR_DET_MODEL=PP-OCRv5_mobile_det
# Languages tried when a request uses "auto".
OCR_AUTO_LANGUAGES=en,hi,kn,te,ta,ml
# Hybrid recognition: PaddleOCR detects/lays out every page; lines in these
# languages are re-read by Tesseract 5, which measured more accurate for them
# (Malayalam has no PaddleOCR model at all). Needs the Tesseract binary plus
# language data: run `python setup_tessdata.py` to fetch it into backend/tessdata.
OCR_TESSERACT_LANGUAGES=kn,ml
# Defaults: tesseract on PATH, else C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Defaults to backend/tessdata when that folder exists.
OCR_TESSDATA_DIR=
# Lines the primary model reads below this score are re-read by the other
# language models; once a page is found to be mixed, every line is compared.
OCR_LANGUAGE_RECHECK_THRESHOLD=0.93
# Lines below this confidence are dropped as noise.
OCR_MIN_LINE_CONFIDENCE=0.35
# Page rotation (0/90/180/270) and small-skew correction. The per-line
# orientation classifier stays off: it misreads upright Hindi as upside down.
OCR_DOC_ORIENTATION=true
OCR_TEXTLINE_ORIENTATION=false
OCR_DESKEW=true
# Pages whose longest side is below OCR_MIN_IMAGE_DIM pixels are upscaled.
OCR_MIN_IMAGE_DIM=1600
OCR_MAX_IMAGE_DIM=2560
OCR_PDF_DPI=300
# Safety limits for evidence fetched and rendered by OCR.
OCR_MAX_FILE_BYTES=52428800
OCR_MAX_PDF_PAGES=50
# PDFs are rendered with pypdfium2; Poppler is only used as a fallback.
POPPLER_PATH=C:\Program Files\poppler\bin

# Optional OCR translation (deep-translator). Providers are tried in order;
# a provider that is rate-limited or blocked is skipped for 5 minutes.
# NOTE: translation sends the OCR text to the provider (Google / MyMemory).
TRANSLATION_PROVIDERS=google,mymemory
TRANSLATION_TIMEOUT_SECONDS=20
TRANSLATION_MAX_CHARS=30000
# Raises MyMemory's free daily quota from ~5,000 to ~50,000 characters.
MYMEMORY_EMAIL=

# Blockchain. Automatic redeployment of a missing EvidenceRegistry is disabled:
# a fresh contract would orphan every existing registration. Keep Ganache
# persistent (blockchain/start-ganache.ps1) and redeploy only deliberately.
BLOCKCHAIN_AUTO_REDEPLOY=false
# Node and contract. EVIDENCE_REGISTRY_ADDRESS is optional when
# blockchain/deployments/localhost.json exists.
ETHEREUM_RPC_URL=http://127.0.0.1:8545
EVIDENCE_REGISTRY_ADDRESS=
# Signing account. Ganache: leave both empty to use its first unlocked account.
# Production: a protected private key (server-side only, never VITE_*). A sender that
# is not the deployer must be authorised: REGISTRAR_ADDRESSES=0x... node scripts/deploy.js
ETHEREUM_SENDER_ADDRESS=
ETHEREUM_PRIVATE_KEY=
# Label shown in the ledger (defaults to "Ganache (local)" for chain id 1337).
BLOCKCHAIN_NETWORK_NAME=
# Timeouts, retries and confirmations. Broadcast transactions are never resent;
# retries apply only when nothing reached the node. Keep confirmations at 0 on Ganache
# (it mines instantly and produces no further blocks while idle).
BLOCKCHAIN_RPC_TIMEOUT_SECONDS=15
BLOCKCHAIN_TX_TIMEOUT_SECONDS=90
BLOCKCHAIN_RETRIES=3
BLOCKCHAIN_CONFIRMATIONS=0
BLOCKCHAIN_EVENT_POLL_SECONDS=10

# Evidence limits. Remote evidence is only fetched from SUPABASE_URL's host.
MAX_UPLOAD_MB=200
MAX_HASH_DOWNLOAD_MB=1024
# Honour X-Forwarded-For for audit IP addresses only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
